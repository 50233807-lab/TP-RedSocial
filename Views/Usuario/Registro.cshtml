@{
    ViewData["Title"] = "Registro";
}

<h1>Registrarse</h1>

<form class="formulario-principal"
      action="@Url.Action("Registro", "Usuario")"
      method="post">

    <label>Nombre</label>

    <input
        type="text"
        name="Nombre"
        required>

    <label>Apellido</label>

    <input
        type="text"
        name="Apellido"
        required>

    <label>Nombre de usuario</label>

    <input
        type="text"
        name="NombreUsuario"
        required>

    <label>Contraseña</label>

    <input
        type="password"
        name="Contraseña"
        required>

    <button type="submit">
        Registrarse
    </button>

</form>

@if (ViewBag.Error != null)
{
    <p>
        @ViewBag.Error
    </p>
}

<p>
    ¿Ya tenés una cuenta?

    <a href="@Url.Action("Login", "Usuario")">
        Iniciar sesión
    </a>
</p>